# Required. Shared HMAC secret for inbound/outbound signatures (fail-closed:
# the engine refuses to boot without it).
AUDIOSONDE_SECRET=change-me

# Optional. A previous secret still accepted on inbound requests, to allow
# zero-downtime secret rotation. Outbound callbacks are always signed with
# AUDIOSONDE_SECRET.
# AUDIOSONDE_SECRET_PREVIOUS=

# Server
# HOST=0.0.0.0
# PORT=8080

# Limits (engine defaults shown)
# MAX_CONCURRENT_JOBS=4
# MAX_SOURCE_BYTES=524288000      # 500 MB
# MAX_DURATION_MS=14400000        # 4 h
# JOB_TIMEOUT_MS=600000           # 10 min
# ANALYZER_TIMEOUT_MS=300000      # 5 min, per analyzer
# SIGNATURE_TOLERANCE_SECONDS=300 # replay window

# Observability
# METRICS_ENABLED=true            # Prometheus GET /metrics (unauthenticated,
#                                 # aggregate counters only — disable if the
#                                 # port is exposed publicly)

# Binary paths (resolved in PATH by default)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# AUDIOWAVEFORM_PATH=audiowaveform
