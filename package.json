{
  "name": "audiosonde",
  "version": "0.0.0",
  "description": "Self-hostable, storage-agnostic audio analysis engine — metadata, LUFS, transcodes, waveform peaks, BPM/key behind one signed HTTP contract.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bench:synthetic": "tsx bench/synthetic.ts",
    "bench:fetch": "tsx bench/fetch-giantsteps.ts",
    "bench:run": "tsx bench/run.ts"
  },
  "dependencies": {
    "essentia.js": "^0.1.3",
    "execa": "^9.5.1",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PierreJung-Dev/audiosonde.git"
  }
}
